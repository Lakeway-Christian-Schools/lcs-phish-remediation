# LCS phishing reporting bridge — configuration template.
# Copy to `.env`, fill in real values, then: chmod 600 .env
# NEVER commit the real .env (see .gitignore).

# --- Ingestion mailbox (IMAP) ---
# Short-term: IONOS. Target state: Exchange Online via OAuth2 (see TASK-07).
IMAP_SERVER=imap.ionos.com
IMAP_USER=gophish-reports@lcstn-ionos.com
IMAP_PASS=change-me            # dedicated service account / app password
IMAP_MAILBOX=INBOX

# --- SMTP (re-injection into Anglerphish reporting mailbox) ---
SMTP_SERVER=smtp.ionos.com
SMTP_PORT=587                  # STARTTLS
SMTP_USER=gophish-reports@lcstn-ionos.com
SMTP_PASS=change-me

# --- Where the bridge re-injects reports ---
GOPHISH_REPORT_TO=reports@phish.lcstn.org

# --- Behavior ---
POLL_INTERVAL_SECONDS=30
LANDING_DOMAINS=phish.lcstn.org,login.lcstn.org,payroll.lcstn.org,docs.lcstn.org
PROCESSED_FOLDER=Processed      # move handled mail here (TASK-05 loop prevention)
LOOP_MARKER_HEADER=X-LCS-Bridge-Processed
LOG_FILE=/opt/gophish-bridge/bridge.log
LOG_LEVEL=INFO
